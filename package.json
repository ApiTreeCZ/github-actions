{
  "name": "@apitree.cz/github-actions",
  "version": "0.6.5",
  "private": true,
  "description": "Reusable GitHub Actions for ApiTree projects",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "fix": "pnpx concurrently --kill-others-on-fail --prefix-colors auto \"pnpm run format\" \"pnpm run lint:fix\"",
    "format": "prettier --check --write .",
    "postinstall": "pnpx is-ci || husky",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "test": "vitest run"
  },
  "devDependencies": {
    "@apitree.cz/eslint-config": "2.2.3",
    "@apitree.cz/lint-staged-config": "1.1.3",
    "@apitree.cz/prettier-config": "1.0.3",
    "@apitree.cz/vitest-config": "1.0.4",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "husky-check-email": "0.0.8",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.x"
  }
}
